# Copy to .env.local (git-ignored). Names only; never commit real values.

# --- Backend demo mode (in-memory store). Leave unset to keep /api/v1 closed (503).
FAIRSHIFT_DEMO_MODE=true
EMPLOYER_PIN=            # required in production; defaults to 1234 only outside production

# --- Supabase (server-side only; NOT wired into the in-memory adapter yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # safe for browsers, protected by RLS
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_
